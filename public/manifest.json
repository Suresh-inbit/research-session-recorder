{
  "manifest_version": 3,
  "name": "Research Session Recorder",
  "version": "1.0.1",
  "description": "Automatically track and organize your research sessions across papers, repositories, documentation, and more.",
  "permissions": [
    "sidePanel",
    "contextMenus",
    "storage",
    "tabs",
    "idle",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"],
    "type": "module"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "research-session-recorder@suresh-inbit.github.io",
      "strict_min_version": "121.0"
    }
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "src/sidepanel/index.html"
  },
  "action": {
    "default_popup": "src/popup/index.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_title": "Research Session Recorder"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "commands": {
    "toggle-note": {
      "suggested_key": {
        "default": "Alt+Shift+N"
      },
      "description": "Toggle quick note on current page"
    },
    "open-side-panel": {
      "suggested_key": {
        "default": "Alt+Shift+R"
      },
      "description": "Open Research Side Panel"
    }
  }
}
